{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\nARG \\w+=(?<currentValue>.*)\\n"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": ["v(?<currentValue>\\d+\\.\\d+\\.\\d+)-dockertag"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/kloudkit/workspace",
      "versioningTemplate": "semver"
    }
  ]
}
